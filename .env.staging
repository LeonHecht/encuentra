# Staging environment variables for Encuentra backend
# NOTE: APP_ENV must be set in the real process environment (not here) to "staging"
# so that backend/app/core/config.py loads this file before the base .env.

# OPENAI
OPENAI_API_KEY=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
OPENAI_CHAT_MODEL=gpt-5-mini
MAX_DOC_TOKENS=2000
MAX_DOCS=3

# Backend selection
SEARCH_BACKEND=opensearch

# S3 corpus and files (staging subset)
S3_BUCKET=encuentra-data
S3_CORPUS_KEY=staging/corpus.jsonl
S3_FILES_PREFIX=staging/files/
S3_URL_TTL=604800

# OpenSearch cluster (reachable from the API host)
# If this uses a private IP, the API must run within the same VPC/network.
OPENSEARCH_HOSTS=zep45ktffevaoy1fiv86.us-east-2.aoss.amazonaws.com    # AWS Opensearch Collection address
OPENSEARCH_AWS_REGION=us-east-1
OPENSEARCH_AWS_SERVICE=aoss
OPENSEARCH_VERIFY_CERTS=true

OPENSEARCH_INDEX_PREFIX=encuentra-stg

# Supabase Staging (service role or anon depending on needs)

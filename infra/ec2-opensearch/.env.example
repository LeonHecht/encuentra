# Backend API settings for an EC2-hosted OpenSearch node.
# Use the EC2 private IP or private DNS when the API runs in the same VPC.

SEARCH_BACKEND=opensearch
OPENSEARCH_HOSTS=http://<ec2-private-ip-or-dns>:9200
OPENSEARCH_SIGV4=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX=encuentra-stg

# Recommended for staging/prod: build a missing index, but do not rebuild on every boot.
SKIP_REINDEX_ON_STARTUP=true
FORCE_REINDEX_ON_STARTUP=false

# Optional when indexing corpus data from S3.
S3_BUCKET=encuentra-data
S3_CORPUS_KEY=staging/corpus.jsonl
S3_TEXT_PREFIX=staging/text/
S3_FILES_PREFIX=staging/files/
S3_URL_TTL=604800
